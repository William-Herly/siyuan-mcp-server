{
  "name": "siyuan-mcp-server",
  "version": "2.0.1",
  "description": "Lightweight MCP server for AI-assisted daily note workflows through the SiYuan CLI.",
  "main": "dist/index.js",
  "bin": {
    "siyuan-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:standard": "node tests/integration/standard.mjs",
    "preversion": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run typecheck && npm run build && npm test",
    "pack": "node -e \"require('node:fs').mkdirSync('artifacts',{recursive:true})\" && npm pack --ignore-scripts --pack-destination artifacts",
    "test:safety": "node tests/integration/safety.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-Herly/siyuan-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/William-Herly/siyuan-mcp-server/issues"
  },
  "homepage": "https://github.com/William-Herly/siyuan-mcp-server#readme",
  "keywords": [
    "siyuan",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "notes",
    "knowledge-management",
    "cli"
  ],
  "author": "William",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "markdown-it": "^15.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
